msgid "Click and drag to navigate the image."
msgstr "Fai clic e trascina per spostarti nell’immagine."

#: src/ui/tool.c:14
msgid "Free-Form Select"
msgstr "Selezione a mano libera"

#: src/ui/tool.c:15
