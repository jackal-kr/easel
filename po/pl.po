msgstr ""
"Wymazuje fragment obrazu. Prawy przycisk: zastępuje kolor pierwszoplanowy "
"kolorem tła."

#: src/ui/tool.c:23
msgid "Fill With Color"
msgstr "Wypełnij kolorem"

#: src/ui/tool.c:24
msgid ""
"Fills an area with the foreground color (left button) or the background "
"color (right button)."
msgstr ""
"Wypełnia obszar kolorem pierwszoplanowym (lewy przycisk) lub tła (prawy "
"przycisk)."

#: src/ui/tool.c:26
msgid "Pick Color"
msgstr "Pobierz kolor"

#: src/ui/tool.c:27
msgid ""
"Picks up a color from the picture for drawing. Left button: foreground. "
"Right button: background."
msgstr ""
"Pobiera kolor z obrazu do rysowania. Lewy przycisk: kolor pierwszoplanowy. "
"Prawy przycisk: kolor tła."

#: src/ui/tool.c:29
msgid "Magnifier"
msgstr "Lupa"

#: src/ui/tool.c:30
msgid "Changes the magnification."
msgstr "Zmienia powiększenie."

#: src/ui/tool.c:32
msgid "Pencil"
msgstr "Ołówek"

#: src/ui/tool.c:33
msgid ""
"Draws a free-form line. Left button: foreground color. Right button: "
"background color."
msgstr ""
"Rysuje linię odręczną. Lewy przycisk: kolor pierwszoplanowy. Prawy przycisk: "
"kolor tła."

#: src/ui/tool.c:35
msgid "Brush"
msgstr "Pędzel"

#: src/ui/tool.c:36
msgid "Draws using a brush with the selected shape and size."
msgstr "Rysuje pędzlem o wybranym kształcie i rozmiarze."

#: src/ui/tool.c:38
msgid "Airbrush"
msgstr "Aerograf"

#: src/ui/tool.c:39
msgid "Draws using an airbrush of the selected size."
msgstr "Rysuje aerografem o wybranym rozmiarze."

#: src/ui/tool.c:42
msgid "Inserts text into the picture."
msgstr "Wstawia tekst do obrazu."

#: src/ui/tool.c:44
msgid "Line"
msgstr "Linia"

#: src/ui/tool.c:45
msgid "Draws a straight line with the selected line width."
msgstr "Rysuje prostą linię o wybranej grubości."

#: src/ui/tool.c:47
msgid "Curve"
msgstr "Krzywa"

#: src/ui/tool.c:48
msgid "Draws a curved line with the selected line width."
msgstr "Rysuje krzywą o wybranej grubości linii."

#: src/ui/tool.c:50
msgid "Rectangle"
msgstr "Prostokąt"

#: src/ui/tool.c:51
msgid "Draws a rectangle with the selected fill style."
msgstr "Rysuje prostokąt z wybranym stylem wypełnienia."

#: src/ui/tool.c:53
msgid "Polygon"
msgstr "Wielokąt"

#: src/ui/tool.c:54
msgid "Draws a polygon with the selected fill style."
msgstr "Rysuje wielokąt z wybranym stylem wypełnienia."

#: src/ui/tool.c:56
msgid "Ellipse"
msgstr "Elipsa"

#: src/ui/tool.c:57
msgid "Draws an ellipse with the selected fill style."
msgstr "Rysuje elipsę z wybranym stylem wypełnienia."

#: src/ui/tool.c:59
msgid "Rounded Rectangle"
msgstr "Prostokąt z zaokrąglonymi rogami"

#: src/ui/tool.c:60
msgid "Draws a rounded rectangle with the selected fill style."
msgstr "Rysuje prostokąt z zaokrąglonymi rogami z wybranym stylem wypełnienia."

