msgstr "Kliknij i przeciągnij, aby przesuwać obraz."

#: src/ui/tool.c:14
msgid "Free-Form Select"
msgstr "Zaznaczanie dowolnego kształtu"

#: src/ui/tool.c:15
msgid "Selects a free-form part of the picture to move, copy, or edit."
msgstr ""
"Zaznacza dowolny fragment obrazu do przeniesienia, skopiowania lub edycji."

#: src/ui/tool.c:17 src/ui/fontdialog.c:237
msgid "Select"
msgstr "Zaznacz"

#: src/ui/tool.c:18
msgid "Selects a rectangular part of the picture to move, copy, or edit."
msgstr ""
"Zaznacza prostokątny fragment obrazu do przeniesienia, skopiowania lub "
"edycji."

