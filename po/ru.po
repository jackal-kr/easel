#: src/ui/tool.c:8
msgid "Gradient"
msgstr "Градиент"

#: src/ui/tool.c:9
msgid ""
"Fills with a blend from the foreground to the background color. Drag to set "
"direction and length."
msgstr "Заливает плавным переходом от основного цвета к фоновому. Перетащите, чтобы задать направление и длину."

#: src/ui/tool.c:11
msgid "Pan"
msgstr "Перемещение"

#: src/ui/tool.c:12
msgid "Click and drag to navigate the image."
msgstr "Щёлкните и перетаскивайте, чтобы перемещаться по рисунку."

#: src/ui/tool.c:14
msgid "Free-Form Select"
msgstr "Выделение произвольной области"

#: src/ui/tool.c:15
msgid "Selects a free-form part of the picture to move, copy, or edit."
msgstr "Выделяет часть рисунка произвольной формы для перемещения, копирования или правки."

#: src/ui/tool.c:17 src/ui/fontdialog.c:237
msgid "Select"
msgstr "Выделение"

#: src/ui/tool.c:18
msgid "Selects a rectangular part of the picture to move, copy, or edit."
msgstr "Выделяет прямоугольную часть рисунка для перемещения, копирования или правки."

#: src/ui/tool.c:20
msgid "Eraser"
msgstr "Ластик"

#: src/ui/tool.c:21
msgid ""
"Erases a portion of the picture. Right button: replaces the foreground color "
"with the background color."
msgstr "Стирает часть рисунка. Правая кнопка: заменяет основной цвет фоновым."

#: src/ui/tool.c:23
msgid "Fill With Color"
msgstr "Заливка"

#: src/ui/tool.c:24
msgid ""
"Fills an area with the foreground color (left button) or the background "
"color (right button)."
msgstr "Заливает область основным цветом (левая кнопка) или фоновым цветом (правая кнопка)."

#: src/ui/tool.c:26
msgid "Pick Color"
msgstr "Выбор цветов"

#: src/ui/tool.c:27
msgid ""
"Picks up a color from the picture for drawing. Left button: foreground. "
"Right button: background."
msgstr "Берёт цвет с рисунка для рисования. Левая кнопка: основной цвет. Правая кнопка: фоновый цвет."

#: src/ui/tool.c:29
msgid "Magnifier"
msgstr "Масштаб"

#: src/ui/tool.c:30
msgid "Changes the magnification."
msgstr "Изменяет увеличение."

#: src/ui/tool.c:32
msgid "Pencil"
msgstr "Карандаш"

#: src/ui/tool.c:33
msgid ""
"Draws a free-form line. Left button: foreground color. Right button: "
"background color."
msgstr "Рисует линию произвольной формы. Левая кнопка: основной цвет. Правая кнопка: фоновый цвет."

#: src/ui/tool.c:35
msgid "Brush"
msgstr "Кисть"

#: src/ui/tool.c:36
msgid "Draws using a brush with the selected shape and size."
msgstr "Рисует кистью выбранной формы и размера."

#: src/ui/tool.c:38
msgid "Airbrush"
msgstr "Распылитель"

#: src/ui/tool.c:39
msgid "Draws using an airbrush of the selected size."
msgstr "Рисует распылителем выбранного размера."

#: src/ui/tool.c:42
msgid "Inserts text into the picture."
msgstr "Вставляет текст в рисунок."

#: src/ui/tool.c:44
msgid "Line"
msgstr "Линия"

#: src/ui/tool.c:45
msgid "Draws a straight line with the selected line width."
msgstr "Рисует прямую линию выбранной толщины."

#: src/ui/tool.c:47
msgid "Curve"
msgstr "Кривая"

#: src/ui/tool.c:48
msgid "Draws a curved line with the selected line width."
msgstr "Рисует кривую линию выбранной толщины."

#: src/ui/tool.c:50
msgid "Rectangle"
msgstr "Прямоугольник"

#: src/ui/tool.c:51
msgid "Draws a rectangle with the selected fill style."
msgstr "Рисует прямоугольник с выбранным стилем заливки."

#: src/ui/tool.c:53
msgid "Polygon"
msgstr "Многоугольник"

#: src/ui/tool.c:54
msgid "Draws a polygon with the selected fill style."
msgstr "Рисует многоугольник с выбранным стилем заливки."

#: src/ui/tool.c:56
msgid "Ellipse"
msgstr "Эллипс"

#: src/ui/tool.c:57
msgid "Draws an ellipse with the selected fill style."
msgstr "Рисует эллипс с выбранным стилем заливки."

#: src/ui/tool.c:59
msgid "Rounded Rectangle"
msgstr "Скруглённый прямоугольник"

#: src/ui/tool.c:60
msgid "Draws a rounded rectangle with the selected fill style."
msgstr "Рисует скруглённый прямоугольник с выбранным стилем заливки."

#: src/ui/fontdialog.c:82
msgid ""
"The sysadmin quickly sudoed the gnomes before they compiled the last of the "
"coffee. Nobody blamed the cat, because the cat had already pushed to "
"production on a Friday. The penguins, meanwhile, held a very serious meeting "
"about kernel panics and herring, and declared it a feature."
msgstr "Сисадмин быстро сделал sudo над гномами, пока те не скомпилировали последний кофе. Кота никто не винил: кот уже успел выкатить код в продакшен в пятницу. Пингвины тем временем провели очень серьёзное совещание о паниках ядра и сельди и объявили это фичей."

