#: src/ui/tool.c:8
msgid "Gradient"
msgstr "Degradado"

#: src/ui/tool.c:9
msgid ""
"Fills with a blend from the foreground to the background color. Drag to set "
"direction and length."
msgstr ""
"Rellena con una mezcla del color de primer plano al de fondo. Arrastra para "
"fijar la dirección y la longitud."

#: src/ui/tool.c:11
msgid "Pan"
msgstr "Desplazar"

#: src/ui/tool.c:12
msgid "Click and drag to navigate the image."
msgstr "Haz clic y arrastra para moverte por la imagen."

#: src/ui/tool.c:14
msgid "Free-Form Select"
msgstr "Selección libre"

#: src/ui/tool.c:15
msgid "Selects a free-form part of the picture to move, copy, or edit."
msgstr ""
"Selecciona una parte de forma libre de la imagen para moverla, copiarla o "
"editarla."

#: src/ui/tool.c:17 src/ui/fontdialog.c:249
msgid "Select"
msgstr "Seleccionar"

#: src/ui/tool.c:18
msgid "Selects a rectangular part of the picture to move, copy, or edit."
msgstr ""
"Selecciona una parte rectangular de la imagen para moverla, copiarla o "
"editarla."

#: src/ui/tool.c:20
msgid "Eraser"
msgstr "Borrador"

#: src/ui/tool.c:21
msgid ""
"Erases a portion of the picture. Right button: replaces the foreground color "
"with the background color."
msgstr ""
"Borra una parte de la imagen. Botón derecho: sustituye el color de primer "
"plano por el de fondo."

#: src/ui/tool.c:23
msgid "Fill With Color"
msgstr "Rellenar con color"

#: src/ui/tool.c:24
msgid ""
"Fills an area with the foreground color (left button) or the background "
"color (right button)."
msgstr ""
"Rellena un área con el color de primer plano (botón izquierdo) o el de fondo "
"(botón derecho)."

#: src/ui/tool.c:26
msgid "Pick Color"
msgstr "Seleccionar color"

#: src/ui/tool.c:27
msgid ""
"Picks up a color from the picture for drawing. Left button: foreground. "
"Right button: background."
msgstr ""
"Toma un color de la imagen para dibujar. Botón izquierdo: primer plano. "
"Botón derecho: fondo."

#: src/ui/tool.c:29
msgid "Magnifier"
msgstr "Lupa"

#: src/ui/tool.c:30
msgid "Changes the magnification."
msgstr "Cambia el aumento."

#: src/ui/tool.c:32
msgid "Pencil"
msgstr "Lápiz"

#: src/ui/tool.c:33
msgid ""
"Draws a free-form line. Left button: foreground color. Right button: "
"background color."
msgstr ""
"Dibuja una línea libre. Botón izquierdo: color de primer plano. Botón "
"derecho: color de fondo."

#: src/ui/tool.c:35
msgid "Brush"
msgstr "Pincel"

#: src/ui/tool.c:36
msgid "Draws using a brush with the selected shape and size."
msgstr "Dibuja con un pincel de la forma y el tamaño seleccionados."

#: src/ui/tool.c:38
msgid "Airbrush"
msgstr "Aerógrafo"

#: src/ui/tool.c:39
msgid "Draws using an airbrush of the selected size."
msgstr "Dibuja con un aerógrafo del tamaño seleccionado."

#: src/ui/tool.c:42
msgid "Inserts text into the picture."
msgstr "Inserta texto en la imagen."

#: src/ui/tool.c:44
msgid "Line"
msgstr "Línea"

#: src/ui/tool.c:45
msgid "Draws a straight line with the selected line width."
msgstr "Dibuja una línea recta con el grosor seleccionado."

#: src/ui/tool.c:47
msgid "Curve"
msgstr "Curva"

#: src/ui/tool.c:48
msgid "Draws a curved line with the selected line width."
msgstr "Dibuja una línea curva con el grosor seleccionado."

#: src/ui/tool.c:50
msgid "Rectangle"
msgstr "Rectángulo"

#: src/ui/tool.c:51
msgid "Draws a rectangle with the selected fill style."
msgstr "Dibuja un rectángulo con el estilo de relleno seleccionado."

#: src/ui/tool.c:53
msgid "Polygon"
msgstr "Polígono"

#: src/ui/tool.c:54
msgid "Draws a polygon with the selected fill style."
msgstr "Dibuja un polígono con el estilo de relleno seleccionado."

#: src/ui/tool.c:56
msgid "Ellipse"
msgstr "Elipse"

#: src/ui/tool.c:57
msgid "Draws an ellipse with the selected fill style."
msgstr "Dibuja una elipse con el estilo de relleno seleccionado."

#: src/ui/tool.c:59
msgid "Rounded Rectangle"
msgstr "Rectángulo redondeado"

#: src/ui/tool.c:60
msgid "Draws a rounded rectangle with the selected fill style."
msgstr "Dibuja un rectángulo redondeado con el estilo de relleno seleccionado."

#: src/ui/fontdialog.c:82
msgid ""
"The sysadmin quickly sudoed the gnomes before they compiled the last of the "
"coffee. Nobody blamed the cat, because the cat had already pushed to "
"production on a Friday. The penguins, meanwhile, held a very serious meeting "
"about kernel panics and herring, and declared it a feature."
msgstr ""
"El sysadmin les hizo sudo a los gnomos en un santiamén, antes de que "
"compilaran lo último del café. Nadie culpó al gato, porque el gato ya había "
"subido a producción un viernes. Los pingüinos, mientras tanto, celebraron "
"una reunión muy seria sobre kernel panics y arenques, y lo declararon una "
"característica."

