#: src/ui/tool.c:39
msgid "Draws using an airbrush of the selected size."
msgstr "Kreslí sprejem zvolené velikosti."

#: src/ui/tool.c:42
msgid "Inserts text into the picture."
msgstr "Vloží do obrázku text."

