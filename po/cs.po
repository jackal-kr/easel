#: src/ui/tool.c:8
msgid "Gradient"
msgstr "Přechod"

#: src/ui/tool.c:9
msgid ""
"Fills with a blend from the foreground to the background color. Drag to set "
"direction and length."
msgstr ""
"Vyplní plynulým přechodem z barvy popředí do barvy pozadí. Tažením nastavíte "
"směr a délku."

#: src/ui/tool.c:11
msgid "Pan"
msgstr "Posun"

#: src/ui/tool.c:12
msgid "Click and drag to navigate the image."
msgstr "Kliknutím a tažením se pohybujete po obrázku."

#: src/ui/tool.c:14
msgid "Free-Form Select"
msgstr "Výběr od ruky"

#: src/ui/tool.c:15
msgid "Selects a free-form part of the picture to move, copy, or edit."
msgstr ""
"Vybere libovolně tvarovanou část obrázku pro přesunutí, kopírování nebo "
"úpravu."

#: src/ui/tool.c:17 src/ui/fontdialog.c:249
msgid "Select"
msgstr "Výběr"

#: src/ui/tool.c:18
msgid "Selects a rectangular part of the picture to move, copy, or edit."
msgstr ""
"Vybere obdélníkovou část obrázku pro přesunutí, kopírování nebo úpravu."

#: src/ui/tool.c:20
msgid "Eraser"
msgstr "Guma"

#: src/ui/tool.c:21
msgid ""
"Erases a portion of the picture. Right button: replaces the foreground color "
"with the background color."
msgstr ""
"Vymaže část obrázku. Pravé tlačítko: nahradí barvu popředí barvou pozadí."

#: src/ui/tool.c:23
msgid "Fill With Color"
msgstr "Vyplnit barvou"

#: src/ui/tool.c:24
msgid ""
"Fills an area with the foreground color (left button) or the background "
"color (right button)."
msgstr ""
"Vyplní oblast barvou popředí (levé tlačítko) nebo barvou pozadí (pravé "
"tlačítko)."

#: src/ui/tool.c:26
msgid "Pick Color"
msgstr "Výběr barvy"

#: src/ui/tool.c:27
msgid ""
"Picks up a color from the picture for drawing. Left button: foreground. "
"Right button: background."
msgstr ""
"Převezme barvu z obrázku pro kreslení. Levé tlačítko: popředí. Pravé "
"tlačítko: pozadí."

#: src/ui/tool.c:29
msgid "Magnifier"
msgstr "Lupa"

#: src/ui/tool.c:30
msgid "Changes the magnification."
msgstr "Mění zvětšení."

#: src/ui/tool.c:32
msgid "Pencil"
msgstr "Tužka"

#: src/ui/tool.c:33
msgid ""
"Draws a free-form line. Left button: foreground color. Right button: "
"background color."
msgstr ""
"Kreslí libovolnou čáru. Levé tlačítko: barva popředí. Pravé tlačítko: barva "
"pozadí."

