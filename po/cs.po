#: src/ui/tool.c:47
msgid "Curve"
msgstr "Křivka"

#: src/ui/tool.c:48
msgid "Draws a curved line with the selected line width."
msgstr "Nakreslí křivou čáru zvolené šířky."

#: src/ui/tool.c:50
msgid "Rectangle"
msgstr "Obdélník"

#: src/ui/tool.c:51
msgid "Draws a rectangle with the selected fill style."
msgstr "Nakreslí obdélník se zvoleným stylem výplně."

#: src/ui/tool.c:53
msgid "Polygon"
msgstr "Mnohoúhelník"

#: src/ui/tool.c:54
msgid "Draws a polygon with the selected fill style."
msgstr "Nakreslí mnohoúhelník se zvoleným stylem výplně."

