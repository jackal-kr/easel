<?xml version="1.0" encoding="UTF-8"?>
<!-- Header bar menus: Image, View, and the app (hamburger) menu. Items whose
     action does not exist are shown disabled. -->
<interface>
  <menu id="image_menu">
    <section>
      <item><attribute name="label" translatable="yes">Flip/Rotate…</attribute><attribute name="action">win.flip-rotate</attribute></item>
      <item><attribute name="label" translatable="yes">Stretch/Skew…</attribute><attribute name="action">win.stretch-skew</attribute></item>
      <item><attribute name="label" translatable="yes">Invert Colors</attribute><attribute name="action">win.invert-colors</attribute></item>
      <item><attribute name="label" translatable="yes">Attributes…</attribute><attribute name="action">win.attributes</attribute></item>
    </section>
    <section>
      <item><attribute name="label" translatable="yes">Clear Image</attribute><attribute name="action">win.clear-image</attribute></item>
      <item><attribute name="label" translatable="yes">Draw Opaque</attribute><attribute name="action">win.draw-opaque</attribute></item>
    </section>
  </menu>

  <!-- Right-click menus on the canvas. -->
  <menu id="selection_menu">
    <section>
      <item><attribute name="label" translatable="yes">Cut</attribute><attribute name="action">win.cut</attribute></item>
      <item><attribute name="label" translatable="yes">Copy</attribute><attribute name="action">win.copy</attribute></item>
      <item><attribute name="label" translatable="yes">Paste</attribute><attribute name="action">win.paste</attribute></item>
    </section>
    <section>
      <item><attribute name="label" translatable="yes">Clear Selection</attribute><attribute name="action">win.clear-selection</attribute></item>
      <item><attribute name="label" translatable="yes">Select All</attribute><attribute name="action">win.select-all</attribute></item>
      <item><attribute name="label" translatable="yes">Copy To…</attribute><attribute name="action">win.copy-to</attribute></item>
    </section>
    <section>
      <item><attribute name="label" translatable="yes">Flip Horizontal</attribute><attribute name="action">win.flip-horizontal</attribute></item>
      <item><attribute name="label" translatable="yes">Flip Vertical</attribute><attribute name="action">win.flip-vertical</attribute></item>
      <submenu>
        <attribute name="label" translatable="yes">Rotate</attribute>
        <item><attribute name="label" translatable="yes">90° Right</attribute><attribute name="action">win.rotate-90</attribute></item>
        <item><attribute name="label" translatable="yes">180°</attribute><attribute name="action">win.rotate-180</attribute></item>
        <item><attribute name="label" translatable="yes">90° Left</attribute><attribute name="action">win.rotate-270</attribute></item>
      </submenu>
      <item><attribute name="label" translatable="yes">Invert Colors</attribute><attribute name="action">win.invert-colors</attribute></item>
    </section>
  </menu>

  <menu id="text_menu">
    <section>
      <item><attribute name="label" translatable="yes">Cut</attribute><attribute name="action">win.text-cut</attribute></item>
      <item><attribute name="label" translatable="yes">Copy</attribute><attribute name="action">win.text-copy</attribute></item>
      <item><attribute name="label" translatable="yes">Paste</attribute><attribute name="action">win.text-paste</attribute></item>
      <item><attribute name="label" translatable="yes">Delete</attribute><attribute name="action">win.text-delete</attribute></item>
    </section>
    <section>
      <item><attribute name="label" translatable="yes">Select All</attribute><attribute name="action">win.text-select-all</attribute></item>
    </section>
  </menu>

  <menu id="view_menu">
    <section>
      <item><attribute name="custom">zoom</attribute></item>
    </section>
    <section>
      <item><attribute name="label" translatable="yes">Normal Size</attribute><attribute name="action">win.zoom-normal</attribute></item>
      <item><attribute name="label" translatable="yes">Large Size</attribute><attribute name="action">win.zoom-large</attribute></item>
      <item><attribute name="label" translatable="yes">Custom Zoom…</attribute><attribute name="action">win.zoom-custom</attribute></item>
    </section>
    <section>
      <item><attribute name="label" translatable="yes">Show Grid</attribute><attribute name="action">win.show-grid</attribute></item>
      <item><attribute name="label" translatable="yes">Show Thumbnail</attribute><attribute name="action">win.show-thumbnail</attribute></item>
    </section>
    <section>
      <item><attribute name="label" translatable="yes">Tool Box</attribute><attribute name="action">win.show-toolbox</attribute></item>
      <item><attribute name="label" translatable="yes">Color Box</attribute><attribute name="action">win.show-colorbox</attribute></item>
      <item><attribute name="label" translatable="yes">Status Bar</attribute><attribute name="action">win.show-statusbar</attribute></item>
      <item><attribute name="label" translatable="yes">Frame Time</attribute><attribute name="action">win.show-frame-time</attribute></item>
    </section>
  </menu>

  <menu id="primary_menu">
    <section>
      <item><attribute name="label" translatable="yes">New</attribute><attribute name="action">win.new</attribute></item>
      <item><attribute name="label" translatable="yes">Save As…</attribute><attribute name="action">win.save-as</attribute></item>
      <item><attribute name="label" translatable="yes">Print…</attribute><attribute name="action">win.print</attribute></item>
    </section>
    <section>
      <submenu>
        <attribute name="label" translatable="yes">Edit</attribute>
        <section>
          <item><attribute name="label" translatable="yes">Cut</attribute><attribute name="action">win.cut</attribute></item>
          <item><attribute name="label" translatable="yes">Copy</attribute><attribute name="action">win.copy</attribute></item>
          <item><attribute name="label" translatable="yes">Paste</attribute><attribute name="action">win.paste</attribute></item>
          <item><attribute name="label" translatable="yes">Clear Selection</attribute><attribute name="action">win.clear-selection</attribute></item>
          <item><attribute name="label" translatable="yes">Select All</attribute><attribute name="action">win.select-all</attribute></item>
        </section>
      </submenu>
      <item><attribute name="label" translatable="yes">Copy To…</attribute><attribute name="action">win.copy-to</attribute></item>
      <item><attribute name="label" translatable="yes">Paste From…</attribute><attribute name="action">win.paste-from</attribute></item>
    </section>
    <section>
      <item><attribute name="label" translatable="yes">Preferences</attribute><attribute name="action">app.preferences</attribute></item>
      <item><attribute name="label" translatable="yes">Keyboard Shortcuts</attribute><attribute name="action">app.shortcuts</attribute></item>
      <item><attribute name="label" translatable="yes">Help</attribute><attribute name="action">app.help</attribute></item>
      <item><attribute name="label" translatable="yes">About Easel</attribute><attribute name="action">app.about</attribute></item>
    </section>
  </menu>
</interface>
