<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.jackal_kr.Easel</id>
  <name>Easel</name>
  <summary>A simple paint program in the spirit of classic Paint</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.jackal_kr">
    <name>JOD (Oleksiy Degtyar)</name>
  </developer>
  <description>
    <p>
      Easel is a native GNOME paint program with the functionality and workflow of the old Microsoft Paint
      of Windows XP, built with GTK 4 and libadwaita.
    </p>
    <ul>
      <li>All the classic tools: pencil, brush, airbrush, eraser, fill, text, line, curve, shapes and selections</li>
      <li>Unlimited-step undo and redo, zoom, pixel grid and thumbnail</li>
      <li>Open and save PNG, JPEG, BMP, TIFF and WebP</li>
      <li>Light and dark style, keyboard shortcuts, Preferences</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>Drawing in the light style</caption>
      <image type="source">https://raw.githubusercontent.com/jackal-kr/easel/v1.0.1/docs/screenshots/main.png</image>
    </screenshot>
    <screenshot>
      <caption>The dark style</caption>
      <image type="source">https://raw.githubusercontent.com/jackal-kr/easel/v1.0.1/docs/screenshots/dark.png</image>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">io.github.jackal_kr.Easel.desktop</launchable>
  <url type="homepage">https://github.com/jackal-kr/easel</url>
  <url type="bugtracker">https://github.com/jackal-kr/easel/issues</url>
  <categories>
    <category>Graphics</category>
  </categories>
  <provides>
    <binary>easel</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.1.3" date="2026-10-14">
      <description>
        <p>Gradients fade to transparent, so a second gradient lays over the first.</p>
      </description>
    </release>
    <release version="1.1.2" date="2026-10-14">
      <description>
        <p>Help opens in the web browser. Faster resize, paste and image transforms.</p>
      </description>
    </release>
    <release version="1.1.1" date="2026-10-14">
      <description>
        <p>Right-click outside a selection with Select or Free-Form Select now offers Paste and the other canvas actions.</p>
      </description>
    </release>
    <release version="1.1.0" date="2026-10-14">
      <description>
        <p>Fit to Window zoom, a configurable grid (cell size and axonometric grid), and Stretch and Skew by percent or exact pixels.</p>
      </description>
    </release>
    <release version="1.0.1" date="2026-10-14">
      <description>
        <p>Adds store screenshots.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-10-14">
      <description>
        <p>First stable release: translations (Polish, Ukrainian), screen-reader labels, a right-click menu in Pan mode, and a choice between fitting a pasted picture to the canvas or resizing the canvas.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-14">
      <description>
        <p>First public version.</p>
      </description>
    </release>
  </releases>
</component>
